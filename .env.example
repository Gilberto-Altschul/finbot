# ── LLM ────────────────────────────────────────────────────────
# Primary   → Google AI Studio (gratuito, 1500 req/dia)
#             https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fallback  → OpenRouter
#             https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fallback  → Groq (gratuito, 14400 req/dia)
#             https://console.groq.com/keys
GROQ_API_KEY=

# Chave Fernet de 32 bytes (base64) para criptografia de dados sensíveis
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Twilio / WhatsApp ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Pluggy ──────────────────────────────────────────────────────
# https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
DEFAULT_ITEM_ID=

# ── App ─────────────────────────────────────────────────────────
ENVIRONMENT=development
SYNC_INTERVAL_HOURS=6
FINBOT_PERSONA=default

# Cartão de crédito (fallback global — substituído por settings do usuário)
CARTAO_DIA_VENCIMENTO=1
CARTAO_DIA_CORTE=24